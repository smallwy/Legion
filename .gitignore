# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Cocos Creator 生成目录（可重建，不入库）----
library/
temp/
local/
build/
profiles/
native/
.cocos-*/

# ---- Node / 工具链 ----
node_modules/
*.tsbuildinfo

# tsc 编译到 tools/_rt-build 的产物 —— 由 tsconfig.homeruntime.build.json 重新生成，
# 和 library/ 一样属于「可重建」，不入库（避免与 .ts 源文件出现两份真相）
client/tools/_rt-build/

# ---- 沙箱侧临时产物 ----
client/tools/*.log
/tmp/

# ---- 原型备份 / 过期截图（本地留档，不入库）----
client/prototype/*.bak-*.html
client/shots/_old/

# ---- 编辑器 ----
.vscode/
.idea/
*.suo
*.user

# ---- 本地工具状态（WorkBuddy 工作区记忆/总览）----
.workbuddy/
