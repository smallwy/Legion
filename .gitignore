# ---- 操作系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Cocos Creator 生成目录（可重建，不入库）----
library/
temp/
local/
build/
profiles/
native/
.cocos-*/

# ---- Node / 工具链 ----
node_modules/
*.tsbuildinfo

# tsc 编译到 tools/_rt-build 的产物 —— 由 tsconfig.homeruntime.build.json 重新生成，
# 和 library/ 一样属于「可重建」，不入库（避免与 .ts 源文件出现两份真相）
client/tools/_rt-build/

# ---- 沙箱侧临时产物 ----
client/tools/*.log
# art-inventory.py 的输出明细：纯生成物，而且里面全是 uuid ——
# 一旦留在仓库里，下次扫引用时会被自己"引用"到，把每张图都判成在用（踩过）
client/tools/_art-inventory.json
/tmp/

# ---- 原型备份 / 过期截图（本地留档，不入库）----
client/prototype/*.bak-*.html

# ---- 编辑器 ----
.vscode/
.idea/
*.suo
*.user

# ---- 本地工具状态（WorkBuddy 工作区记忆/总览）----
.workbuddy/

# ---- 验证轮次产物（随时可重跑生成）----
.playwright-mcp/
client/prototype/_check2/

# client/shots 是工具的**落点**，不是仓库的一部分。
# 值得留的评审图一律人工归档到 client/art/04-review/ 再入库。
# 之前是「按前缀忽略」，结果 _ab-* / _chk-* / _p-* 这些一次性的对比图
# 攒了 150 多张进仓库，翻起来全是噪音。
#
# 只忽略内容、放行 README：目录本身必须存在（不少工具直接 writeFileSync，
# 不自己 mkdir，新克隆少这个目录会直接崩），而且点进去要有人告诉它「这里可以随便删」。
client/shots/*
!client/shots/README.md
